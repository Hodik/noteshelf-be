    "definitions": {
        "main.BookWithDetails": {
            "type": "object",
            "properties": {
                "book": {
                    "$ref": "#/definitions/repository.Book"
                },
                "current_page": {
                    "type": "integer",
                    "example": 150
                },
                "read_url": {
                    "type": "string",
                    "example": "https://cloudfront.net/signed-url"
                }
            }
        },
        "main.ConfirmBookUploadRequest": {
            "type": "object",
            "required": [
                "title"
            ],
            "properties": {
                "author": {
                    "type": "string",
                    "example": "Alan Donovan"
                },
                "s3_key": {
                    "type": "string",
                    "example": "user123/my-book.pdf"
                },
                "title": {
                    "type": "string",
                    "example": "The Go Programming Language"
                },
                "total_pages": {
                    "type": "integer",
                    "example": 380
                }
            }
        },
        "main.CreateNoteRequest": {
            "type": "object",
            "required": [
                "content"
            ],
            "properties": {
                "color": {
                    "type": "string",
                    "example": "#ffff00"
                },
                "content": {
                    "type": "string",
                    "example": "This is an important point"
                },
                "pdf_reference": {
                    "$ref": "#/definitions/main.PDFReferenceRequest"
                }
            }
        },
        "main.ErrorResponse": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Invalid request"
                },
                "metadata": {
                    "type": "string",
                    "example": "Additional error context"
                },
                "request_id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "statusCode": {
                    "type": "integer",
                    "example": 400
                }
            }
        },
        "main.NoteWithReference": {
            "type": "object",
            "properties": {
                "note": {
                    "$ref": "#/definitions/repository.Note"
                },
                "pdf_reference": {
                    "$ref": "#/definitions/repository.PdfReference"
                }
            }
        },
        "main.PDFReferenceRequest": {
            "type": "object",
            "required": [
                "page_number",
                "x_start",
                "y_start"
            ],
            "properties": {
                "page_number": {
                    "type": "integer",
                    "example": 1
                },
                "x_end": {
                    "type": "number",
                    "example": 200.5
                },
                "x_start": {
                    "type": "number",
                    "example": 100.5
                },
                "y_end": {
                    "type": "number",
                    "example": 400.5
                },
                "y_start": {
                    "type": "number",
                    "example": 300.5
                }
            }
        },
        "main.SuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Operation completed successfully"
                },
                "request_id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                }
            }
        },
        "main.UpdateNoteRequest": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string",
                    "example": "#ff0000"
                },
                "content": {
                    "type": "string",
                    "example": "Updated note content"
                }
            }
        },
        "main.UpdateReadingProgressRequest": {
            "type": "object",
            "required": [
                "current_page"
            ],
            "properties": {
                "current_page": {
                    "type": "integer",
                    "example": 150
                },
                "total_pages": {
                    "type": "integer",
                    "example": 380
                }
            }
        },
        "main.UploadBookRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "example": "my-book.pdf"
                }
            }
        },
        "main.UploadUrlResponse": {
            "type": "object",
            "properties": {
                "presigned_url": {
                    "type": "string",
                    "example": "https://s3.amazonaws.com/bucket/presigned-url"
                },
                "s3_key": {
                    "type": "string",
                    "example": "user123/my-book.pdf"
                }
            }
        },
        "main.WaitListEmailRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "user@example.com"
                }
            }
        },
        "repository.Book": {
            "type": "object",
            "properties": {
                "added_at": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
