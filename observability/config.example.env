# OpenTelemetry Configuration
OTEL_SERVICE_NAME=noteshelf-api
OTEL_SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# OpenTelemetry Sampling (0.0 to 1.0)
# Use 1.0 (100%) in development, 0.1 (10%) in production for cost management
OTEL_TRACE_SAMPLE_RATE=1.0

# Grafana Cloud OpenTelemetry Configuration (Standard OTLP Environment Variables)
# Replace with your actual Grafana Cloud OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-us-west-0.grafana.net/otlp"

# Replace with your actual Grafana Cloud credentials (Base64 encoded: instance_id:api_key)
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic YOUR_BASE64_ENCODED_CREDENTIALS"

# Alternative: Set resource attributes
OTEL_RESOURCE_ATTRIBUTES="service.name=noteshelf-api,service.namespace=noteshelf,deployment.environment=development"

# Database Configuration (existing)
DATABASE_URL=postgresql://user:password@localhost:5432/noteshelf

# AWS S3 Configuration (existing)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket-name

# Clerk Authentication (existing)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Other existing configuration...
PORT=8080
GIN_MODE=debug 